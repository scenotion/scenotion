{
  "name": "scenotion",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Scenotion: an open-source technical video toolkit built on Motion Canvas.",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run build:ui && vite",
    "serve": "npm run build:ui && vite",
    "build:ui": "npm --prefix packages/scenotion-ui run build",
    "build": "npm run build:ui && tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite build",
    "check": "npm run build:ui && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "npm run build:ui && tsc -p tsconfig.tests.json && tsc -p tsconfig.editor.json",
    "review": "node scripts/export-review.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/python": "^1.1.19",
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@motion-canvas/ffmpeg": "3.17.2",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@motion-canvas/vite-plugin": "3.17.2",
    "@preact/preset-vite": "^2.7.0",
    "@preact/signals": "^1.3.4",
    "@scenotion/editor": "file:./editor",
    "@scenotion/ui": "file:./packages/scenotion-ui",
    "@types/node": "^20.19.43",
    "clsx": "^2.0.0",
    "cross-env": "^10.1.0",
    "highlight.js": "^11.9.0",
    "preact": "^10.29.8",
    "sass": "^1.69.5",
    "source-map-js": "^1.0.2",
    "vite-plugin-dts": "^3.6.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild": true
  }
}
