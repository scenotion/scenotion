{
  "name": "scenotion",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Scenotion: an open-source technical video toolkit built on Motion Canvas.",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "serve": "vite",
    "build": "tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite build",
    "check": "tsc --noEmit",
    "review": "node scripts/export-review.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/python": "^1.1.19",
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@motion-canvas/ffmpeg": "3.17.2",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
